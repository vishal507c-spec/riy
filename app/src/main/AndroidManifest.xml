<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed by the filtering VPN service to reach upstream DNS resolvers,
         and by the auto-updater to reach the GitHub Releases API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required on API 26+ to install an APK the app downloaded itself.
         Android still enforces signature checks at install time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Drive backup OAuth: enumerate a Google account + get an OAuth2 access token (no secret). -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.USE_CREDENTIALS" />

    <!-- Content blocker: persistent foreground VPN service + reboot restore. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        PACKAGE VISIBILITY (Android 11+ / targetSdk 30+).

        RIY targets the newest SDK, so the platform hides other apps' packages
        from it by default. The app policy resolver discovers the device's REAL
        dialer, emergency dialer and wallet apps by querying the intent actions
        below; without these declarations every such query returns empty and the
        resolver legitimately reports the packages as UNRESOLVED.

        This block declares VISIBILITY ONLY — it lets PackageManager see which
        apps declare these filters. It grants no permission, adds no package
        name, and decides nothing about what is allowed; the resolver still
        performs discovery and the enforcement engine's safety gate still
        decides what is safe to apply.
    -->
    <queries>

        <!-- The device's dialer / phone app (ACTION_DIAL, ACTION_CALL). -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CALL" />
        </intent>

        <!-- The emergency dialer. -->
        <intent>
            <action android:name="android.intent.action.DIAL_EMERGENCY" />
        </intent>

        <!-- Wallet / UPI payment apps (declared via the upi URI scheme). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>

    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Riy">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- DNS-filtering VPN service. Only the system (which holds
             BIND_VPN_SERVICE) may bind it. The android.net.VpnService action
             enables the system "Always-On VPN" option. -->
        <service
            android:name=".blocker.BlockerVpnService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="DNS-based adult content filtering VPN" />
        </service>

        <!-- Restores protection automatically after a device reboot. -->
        <receiver
            android:name=".blocker.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Device Admin component. This is the anchor the system uses to
             identify RIY when it is provisioned as the Device Owner. Only the
             system (holder of BIND_DEVICE_ADMIN) may bind it. -->
        <receiver
            android:name=".admin.RiyDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
        </receiver>

        <!-- Package-state watchdog: wakes only on real Android package
             broadcasts aimed at RIY (no polling). Used to detect OEM
             freezer/power-manager actuation and record it as an integrity
             result. -->
        <receiver
            android:name=".protection.integrity.PackageStateWatcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_CHANGED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Verifies package protection after a reboot and re-applies the one
             idempotent Device Owner protection (uninstall blocking). Never
             reinstalls or downloads anything. -->
        <receiver
            android:name=".protection.recovery.PackageBootRecovery"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider used to hand the downloaded, verified update APK to the
             system package installer. The file lives in app-private storage
             (no world-readable files, no broad storage permission). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
