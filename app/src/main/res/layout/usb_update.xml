<?xml version="1.0" encoding="utf-8"?>
<!--
    USB UPDATE screen.

    Premium and quiet on purpose: one headline, one honest status chip, four short
    steps, one readable command block and three clear actions. No developer noise,
    no raw error text, no log lines.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/riy_void"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="26dp"
        android:paddingEnd="22dp"
        android:paddingBottom="8dp">

        <!-- Header -->
        <TextView
            android:id="@+id/usbEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.22"
            android:text="@string/usb_eyebrow"
            android:textColor="@color/riy_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/usbVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="@color/riy_text"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="Riy 2.7.0" />

        <TextView
            android:id="@+id/usbSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/usb_subtitle"
            android:textColor="@color/riy_telemetry"
            android:textSize="13sp" />

        <!-- Honest status chip -->
        <LinearLayout
            android:id="@+id/usbStatusRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_riy_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp">

            <View
                android:id="@+id/usbStatusDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/bg_riy_badge" />

            <TextView
                android:id="@+id/usbStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:textColor="@color/riy_text"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Ready to update" />
        </LinearLayout>

        <TextView
            android:id="@+id/usbStatusDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/riy_telemetry"
            android:textSize="13sp"
            tools:text="Connect your phone by USB." />

        <!-- Steps card -->
        <LinearLayout
            android:id="@+id/usbStepsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_riy_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/usbStepBadge1"
                    style="@style/RiyStepBadge"
                    android:text="1" />

                <TextView
                    style="@style/RiyStepText"
                    android:text="@string/usb_step_1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/usbStepBadge2"
                    style="@style/RiyStepBadge"
                    android:text="2" />

                <TextView
                    style="@style/RiyStepText"
                    android:text="@string/usb_step_2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/usbStepBadge3"
                    style="@style/RiyStepBadge"
                    android:text="3" />

                <TextView
                    style="@style/RiyStepText"
                    android:text="@string/usb_step_3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/usbStepBadge4"
                    style="@style/RiyStepBadge"
                    android:text="4" />

                <TextView
                    style="@style/RiyStepText"
                    android:text="@string/usb_step_4" />
            </LinearLayout>
        </LinearLayout>

        <!-- Command card -->
        <LinearLayout
            android:id="@+id/usbCommandCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_riy_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/usbCommandLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.14"
                android:text="@string/usb_command_label"
                android:textColor="@color/riy_telemetry"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/usbCommand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/riy_cyan"
                android:textIsSelectable="true"
                android:textSize="14sp"
                tools:text="adb install -r riy-v2.7.0.apk" />

            <TextView
                android:id="@+id/usbCommandHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/riy_telemetry"
                android:textSize="12sp"
                tools:text="The APK is in Downloads/Riy on this phone." />
        </LinearLayout>

        <!-- Actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/usbCopyCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.06"
            android:text="@string/usb_action_copy_command"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/usbCheckConnection"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.06"
            android:text="@string/usb_action_check_connection"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/usbRetry"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.06"
            android:text="@string/usb_action_retry"
            android:textAllCaps="false"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>