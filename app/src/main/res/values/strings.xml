    <!--
        ZERO-CONFUSION UI (Phase 10).

        Everything a user sees is written in plain human language. The internal
        protection states (NORMAL / SUSPICIOUS / CONFIRMED / RESTRICTED /
        HARDENED / RECOVERY) are NEVER shown verbatim, and neither is any engine
        name, package name, domain, DNS fact, score or evidence id.
    -->

    <!-- One large status title per situation -->
    <string name="status_protected_title">You\'re Protected</string>
    <string name="status_protected_detail">RIY is protecting this device.</string>

    <string name="status_restricted_title">Restricted Mode</string>
    <string name="status_restricted_detail">RIY is temporarily limiting this device.</string>

    <string name="status_hardened_title">Extra Protection</string>
    <string name="status_hardened_detail">RIY has strengthened protection after repeated protection triggers.</string>

    <string name="status_recovery_title">Restoring Protection</string>
    <string name="status_recovery_detail">RIY is restoring your protection.\nPlease wait.</string>

    <string name="status_mismatch_title">Protection Needs Attention</string>
    <string name="status_mismatch_detail">RIY detected that protection needs to be restored.\nRIY is working to restore your protection.</string>

    <!-- The single primary status card line -->
    <string name="protection_active_line">Protection Active</string>
    <string name="protection_active_normal">Protection is running normally.</string>
    <string name="protection_active_restricted">Some apps are temporarily unavailable.</string>
    <string name="protection_active_hardened">Restricted Mode is still active.</string>

