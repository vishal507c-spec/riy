    <string name="filter_connecting">Activating the VPN filter…</string>
    <string name="filter_off">No filtering is running right now.</string>

    <!-- Network-filter status. Each state gets its own wording: the app must
         never show a reassuring "protected" line for a state that is not. -->
    <string name="filter_label_verified">Adult Sites Blocked</string>
    <string name="filter_verified">RIY tested the filter and confirmed that adult sites are blocked, while normal websites still open.</string>

    <string name="filter_label_unverified">Running — Not Verified</string>
    <string name="filter_unverified">The filter is running, but RIY has not been able to confirm the protection. An app that uses its own secure DNS can get around any website filter.</string>

